{
  "name": "argopecten/aegir-provision",
  "description": "Aegir Provision: Drush 13 backend automation for Drupal 11+ hosting management",
  "type": "drupal-drush",
  "license": "GPL-2.0-or-later",
  "homepage": "https://aegir.hu/",
  "keywords": ["aegir", "provision", "hosting", "backend", "automation", "drush"],
  "authors": [
    {
      "name": "Aegir D11 Project",
      "homepage": "https://aegir.hu/"
    }
  ],
  "support": {
    "issues": "https://github.com/argopecten/aegir-provision/issues",
    "source": "https://github.com/argopecten/aegir-provision",
    "docs": "https://github.com/argopecten/aegir-provision/wiki"
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "drush/drush": "^13.6",
    "symfony/process": "^7.0",
    "symfony/yaml": "^7.0",
    "symfony/filesystem": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Aegir\\ProvisionD11\\": "src/"
    }
  },
  "extra": {
    "drush": {
      "services": {
        "drush.services.yml": "^13"
      }
    },
    "branch-alias": {
      "dev-main": "11.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
